{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/generate.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/home", "destination": "/" },
    { "source": "/editor", "destination": "/" },
    { "source": "/settings", "destination": "/" },
    { "source": "/s/:slug([A-Za-z0-9_-]{6,64})", "destination": "/" }
  ]
}
